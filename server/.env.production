NODE_ENV=production
PORT=5000
CLIENT_URL=https://blockcertify-platform.vercel.app
SERVER_URL=https://blockcertify-platform-api.onrender.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/blockcertify
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=change-this-to-a-long-random-secret-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BlockCertify <no-reply@blockcertify.com>
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
ETH_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
ETH_PRIVATE_KEY=
ETH_CONTRACT_ADDRESS=
ETH_NETWORK_NAME=sepolia
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
