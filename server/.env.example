
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Public base URL of THIS server, used to build links to locally-stored files
# when Pinata/IPFS is not configured (see PINATA_JWT below).
SERVER_URL=http://localhost:5000

# Local MongoDB for the demo. Use MongoDB Atlas' connection string instead if
# you'd rather not run Mongo on your own machine.
MONGODB_URI=mongodb://127.0.0.1:27017/blockcertify

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=replace_with_long_random_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BlockCertify <no-reply@blockcertify.com>

# Optional. Leave PINATA_JWT empty to store certificate files/metadata on this
# server's local disk instead of real IPFS -- this is enough for a demo and
# needs no signup. Add a real Pinata JWT later to pin to real IPFS/Pinata.
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud

ETH_RPC_URL=http://127.0.0.1:8545
# This is Hardhat's well-known, publicly documented local test account #0
# private key (derived from the standard "test test test ... junk" mnemonic
# that ships with Hardhat). It only has value on your local throwaway chain.
# NEVER reuse this key on a real network or send it real funds.
ETH_PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Filled in automatically by scripts/start-demo.ps1 after it deploys the
# contract to your local Hardhat node. You can also paste it in manually --
# see DEMO_GUIDE.md.
ETH_CONTRACT_ADDRESS=
ETH_NETWORK_NAME=hardhat
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
