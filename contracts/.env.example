
# Only needed if you deploy to the public Sepolia testnet instead of the
# local Hardhat network. Leave these blank for the local demo -- Hardhat
# validates every network in hardhat.config.ts on startup, and a non-empty
# but invalid PRIVATE_KEY here will make even the local node fail to start.
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
